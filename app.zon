.{
    .id = "dev.native_sdk.forge-ade-native",
    .name = "forge-ade-native",
    .display_name = "ForgeADE",
    .description = "Native AI Development Workspace",
    .version = "0.5.0",
    .icons = .{ "assets/icon.png" },
    .platforms = .{ "macos", "linux" },
    .permissions = .{ "view", "command", "window", "filesystem", "dialog", "clipboard", "network" },
    .capabilities = .{ "webview", "js_bridge" },
    .frontend = .{
        .dist = "frontend/dist",
        .entry = "index.html",
        .spa_fallback = true,
        .dev = .{
            .url = "http://127.0.0.1:5173/",
            .command = .{ "bun", "run", "--cwd", "frontend", "dev", "--host", "127.0.0.1" },
            .ready_path = "/",
            .timeout_ms = 30000,
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{
                "zero://app",
                "zero://inline",
                "http://127.0.0.1:5173",
                "http://localhost:5173",
            },
            .external_links = .{ .action = "deny" },
        },
    },
    .bridge = .{
        .commands = .{
            .{ .name = "terminal.spawn", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "terminal.write", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "terminal.resize", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "terminal.kill", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "terminal.list", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "fs.readDir", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "fs.readFile", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "fs.writeFile", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "fs.createFile", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "fs.createDir", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "fs.getCwd", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "fs.watch", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "fs.unwatch", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "fs.search", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "git.status", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "git.commit", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "git.push", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "git.stage", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "git.unstage", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "git.log", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "git.graph", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "git.show", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "git.diff", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "lsp.start", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "lsp.write", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "lsp.stop", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "command.exec", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "native-sdk.dialog.openFile", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "native-sdk.dialog.saveFile", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "native-sdk.dialog.showMessage", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "native-sdk.clipboard.readText", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "native-sdk.clipboard.writeText", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "native-sdk.os.openUrl", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
            .{ .name = "native-sdk.os.revealPath", .origins = .{ "zero://app", "http://127.0.0.1:5173", "http://localhost:5173" } },
        },
    },
    .web_engine = "system",
    .cef = .{ .dir = "third_party/cef/macos", .auto_install = false },
    .windows = .{
        .{
            .label = "main",
            .title = "ForgeADE",
            .width = 1280,
            .height = 800,
            .restore_state = true,
        },
    },
}
